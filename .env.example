# Copy this file to .env and fill in the values from your Supabase project
# (Project settings -> API). Both are safe to expose in the browser: the
# publishable key only does what your Row Level Security policies allow.
# Never put a secret key (sb_secret_...) in here - it bypasses every policy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
